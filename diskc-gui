#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
diskc-gui —— 磁盘垃圾清理(图形界面)

扫描 → 左侧勾选类别 → 右侧查看明细 → 清理选中。
系统级项目(日志/apt/coredump)需要管理员权限,会转交终端执行。
"""

import os
import subprocess
import sys
import threading
import time

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, GLib, Gdk, Gio, Pango, GObject  # noqa: E402

HERE = os.path.dirname(os.path.realpath(__file__))
DISKC = os.path.join(HERE, 'diskc')

from importlib.machinery import SourceFileLoader  # noqa: E402
CORE = SourceFileLoader('diskc_core', DISKC).load_module()

RISK_COLOR = {'safe': '#2e7d32', 'careful': '#b26a00', 'risky': '#c62828'}
RISK_LABEL = {'safe': '安全', 'careful': '谨慎', 'risky': '高风险'}

# ---- ListStore 列定义
C_SEL, C_TITLE, C_RISK, C_RISKCOL, C_SIZE, C_COUNT, C_NOTE, C_KEY, C_ROOT = range(9)


def hsize(n):
    return CORE.hsize(n)


def disk_usage(path):
    try:
        st = os.statvfs(path)
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        return total, total - free, free
    except OSError:
        return 0, 0, 0


class Cleaner(Gtk.Window):

    def __init__(self):
        Gtk.Window.__init__(self, title='磁盘垃圾清理')
        self.set_default_size(1080, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect('destroy', Gtk.main_quit)
        self.connect('key-press-event', self._on_win_key)

        self.days = 30
        self.results = {}
        self.idx = {}          # key -> 显示序号
        self.scanning = False
        self.cleaning = False
        self.first_scan = True
        self.pending_select = None
        self.detail_query = ''
        self.detail_title = ''
        self.detail_total = 0
        self.detail_size = 0
        self.detail_err = ''

        self._build_css()
        self._build_ui()
        self.rescan()

    # ------------------------------------------------------------ 外观

    def _build_css(self):
        css = b"""
        .dim { color: #888888; }
        .total { font-weight: bold; font-size: 15px; }
        progressbar trough { min-height: 8px; }
        """
        prov = Gtk.CssProvider()
        prov.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


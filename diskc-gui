        box.pack_start(bottom, False, False, 0)

        self.sum_label = Gtk.Label()
        self.sum_label.set_xalign(0)
        self.sum_label.get_style_context().add_class('total')
        bottom.pack_start(self.sum_label, True, True, 0)

        self.status = Gtk.Label()
        self.status.get_style_context().add_class('dim')
        bottom.pack_start(self.status, False, False, 0)


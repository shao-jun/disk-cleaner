        r.set_property('xalign', 1.0)
        c = Gtk.TreeViewColumn('大小', r, text=1)
        c.set_fixed_width(78)
        c.set_sort_column_id(0)
        dtv.append_column(c)

        r = Gtk.CellRendererText()
        c = Gtk.TreeViewColumn('修改时间', r, text=2)
        c.set_fixed_width(122)
        dtv.append_column(c)

        r = Gtk.CellRendererText()
        r.set_property('ellipsize', Pango.EllipsizeMode.MIDDLE)
        c = Gtk.TreeViewColumn('路径', r, text=3)
        c.set_expand(True)
        dtv.append_column(c)

        sw2 = Gtk.ScrolledWindow()
        sw2.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)

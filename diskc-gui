        self.combo.set_active_id('30')
        self.combo.connect('changed', self._on_days_changed)
        top.pack_start(self.combo, False, False, 0)

        btn_none = Gtk.Button(label='清空选择')
        btn_none.connect('clicked', lambda *a: self.select_by_risk(()))
        top.pack_end(btn_none, False, False, 0)

        btn_safe = Gtk.Button(label='全选安全项')
        btn_safe.connect('clicked', lambda *a: self.select_by_risk(('safe',)))
        top.pack_end(btn_safe, False, False, 0)

        box.pack_start(Gtk.Separator(), False, False, 0)

        # ---- 主体:左类别 / 右明细
        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)

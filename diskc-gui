        self.results = {}
        self.idx = {}          # key -> 显示序号
        self.scanning = False
        self.cleaning = False
        self.first_scan = True
        self.pending_select = None
        self.sel = {}          # 类别 key -> 已勾选的具体文件路径集合
        self.detail_key = ''   # 右侧当前显示的是哪个类别
        self.detail_query = ''
        self.detail_title = ''
        self.detail_total = 0
        self.detail_size = 0
        self.detail_err = ''

        # 提权方式探测:优先用图形认证(pkexec),避免弹终端
        self.can_pkexec = bool(shutil.which('pkexec'))
        self.sudo_cached = self._sudo_cached()

        self._build_css()
        self._build_ui()
        self.rescan()

    def _sudo_cached(self):
        """sudo 是否处于免密窗口(刚输过密码的 15 分钟内)。"""
        try:
            return subprocess.call(['sudo', '-n', 'true'],
                                   stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL) == 0
        except OSError:
            return False


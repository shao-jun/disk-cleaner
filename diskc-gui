    # ------------------------------------------------------------ 磁盘用量

    def update_disk_label(self):
        total, used, free = disk_usage(CORE.HOME)
        pct = (100.0 * used / total) if total else 0
        self.disk_label.set_markup(
            '磁盘 <b>%s</b> / %s 已用(%.0f%%),可用 <b>%s</b>'
            % (hsize(used), hsize(total), pct, hsize(free)))
        self.disk_bar.set_fraction(min(pct / 100.0, 1.0))
        self.disk_bar.set_text('%.0f%%' % pct)

    # ------------------------------------------------------------ 扫描

    def _on_days_changed(self, combo):
        d = int(combo.get_active_id() or 30)
        if d == self.days:
            return
        self.days = d
        self.rescan()

    def rescan(self):
        if self.scanning or self.cleaning:
            return
        self.scanning = True
        self.spinner.start()
        self.status.set_text('扫描中…')
        # 把当前勾选快照传下去:重扫后仍存在的文件继续保持勾选
        snapshot = dict((k, set(v)) for k, v in self.sel.items() if v)
        threading.Thread(target=self._scan_worker, args=(self.days, snapshot),
                         daemon=True).start()

    def _scan_worker(self, days, checked):
        try:
            res = CORE.scan_all(days, verbose=False)
        except Exception as e:      # 兜底,别让线程静默死掉
            res = {}
        GLib.idle_add(self._scan_done, res, checked)

    def _scan_done(self, res, checked):
        self.results = res
        self.cat_store.clear()
        self.idx = {}
        self.sel = {}
        i = 0
        for cat in CORE.CATALOG:
            key = cat[0]
            if key not in res:
                continue
            i += 1
            self.idx[key] = i
            title, risk = cat[1], cat[2]
            need_root = cat[5]
            r = res[key]
            size = sum(s for _, s in r['items'])
            note = ''
            if r.get('err'):
                note = '需授权' if need_root else '出错'
            elif need_root:
                if self.sudo_cached:
                    note = ''                      # 已经在免密窗口,直接删
                elif self.can_pkexec:
                    note = '需授权'                # 清理时弹系统认证框
                else:
                    note = '需密码'
            paths = set(p for p, _ in r['items'])
            keep = paths & checked.get(key, set())
            if self.first_scan and cat[6]:
                keep = paths
            self.sel[key] = keep
            on = bool(paths) and keep >= paths
            part = bool(keep) and keep < paths
            self.cat_store.append([
                on, title, RISK_LABEL[risk], RISK_COLOR[risk],
                hsize(size), str(len(r['items'])), note, key, need_root, part])
        self.first_scan = False
        self.spinner.stop()
        self.scanning = False
        total = sum(sum(x[1] for x in res[k]['items']) for k in res)
        self.status.set_text('扫描完成,共 %d 类 / %s' % (len(self.idx), hsize(total)))
        self.update_disk_label()
        self.update_summary()
        self._select_first_row()
        if self.pending_select:
            n, self.pending_select = self.pending_select, None
            self.select_row(n)

    def _select_first_row(self):
        it = self.cat_store.get_iter_first()
        if it:
            self.cat_sel.select_iter(it)

    def select_row(self, n):
        """按显示序号选中某一行(供截图/脚本验证用)"""
        if self.scanning or self.cat_store.get_iter_first() is None:
            self.pending_select = n
            return
        it = self.cat_store.get_iter_first()
        i = 1
        while it is not None and i < n:
            it = self.cat_store.iter_next(it)
            i += 1
        if it is not None:
            self.cat_sel.select_iter(it)
            self.cat_tv.scroll_to_cell(self.cat_store.get_path(it), None, False, 0, 0)

    # ------------------------------------------------------------ 选择

    def _items_of(self, key):
        r = self.results.get(key)
        return r['items'] if r else []

    def _cat_iter(self, key):
        it = self.cat_store.get_iter_first()
        while it is not None:
            if self.cat_store.get_value(it, C_KEY) == key:
                return it
            it = self.cat_store.iter_next(it)
        return None

    def _on_toggle(self, renderer, path):
        """左侧勾选 = 整类全选 / 整类清空;部分选中时点一下变全选。"""
        it = self.cat_store.get_iter(path)
        key = self.cat_store.get_value(it, C_KEY)
        paths = set(p for p, _ in self._items_of(key))
        cur = self.sel.get(key, set())
        if paths and cur >= paths:
            self.sel[key] = set()
        else:
            self.sel[key] = paths
        self._sync_cat(key)
        self._sync_detail_checks(key)
        self.update_summary()

    def _sync_cat(self, key):
        """按已勾选的文件回写左侧勾选状态(全选 / 半选 / 空)。"""
        it = self._cat_iter(key)
        if it is None:
            return
        n = len(self._items_of(key))
        c = len(self.sel.get(key, ()))
        self.cat_store.set_value(it, C_SEL, n > 0 and c >= n)
        self.cat_store.set_value(it, C_PART, 0 < c < n)

    def checked_keys(self):
        return [row[C_KEY] for row in self.cat_store if row[C_SEL] or row[C_PART]]

    def select_by_risk(self, risks):
        risk_of = dict((c[0], c[2]) for c in CORE.CATALOG)
        for row in self.cat_store:
            key = row[C_KEY]
            paths = set(p for p, _ in self._items_of(key))
            want = risk_of.get(key) in risks and bool(paths)
            row[C_SEL] = want
            row[C_PART] = False
            self.sel[key] = paths if want else set()
        self._sync_detail_checks()
        self.update_summary()

    def selected_items(self):
        """只返回真正被勾选的文件 [(path, size), ...]。"""
        out = []
        for key, paths in self.sel.items():
            if not paths:
                continue
            for p, s in self._items_of(key):
                if p in paths:
                    out.append((p, s))
        return out

    def selected_plan(self):
        """key -> [(path, size)],按左侧显示顺序,只含被勾选的文件。"""
        plan = {}
        for row in self.cat_store:
            key = row[C_KEY]
            paths = self.sel.get(key)
            if not paths:
                continue
            items = [(p, s) for p, s in self._items_of(key) if p in paths]
            if items:
                plan[key] = items
        return plan

    def selected_size(self):
        return sum(s for _, s in self.selected_items())

    def update_summary(self):
        keys = self.checked_keys()
        nfiles = len(self.selected_items())
        size = self.selected_size()
        self.sum_label.set_markup('已选 %d 类 / %d 个文件,合计 <b>%s</b>'
                                  % (len(keys), nfiles, hsize(size)))
        self.clean_btn.set_sensitive(nfiles > 0 and not self.scanning
                                     and not self.cleaning)
        if nfiles:
            self.clean_btn.set_label('清理选中(%s)' % hsize(size))
        else:
            self.clean_btn.set_label('清理选中')

    # ------------------------------------------------------------ 明细

    def _on_cat_selected(self, sel):
        model, it = sel.get_selected()
        if it is None:
            return
        key = model.get_value(it, C_KEY)
        r = self.results.get(key)
        if not r:
            return
        title = model.get_value(it, C_TITLE)
        items = sorted(r['items'], key=lambda x: -x[1])
        self.detail_key = key
        picked = self.sel.get(key, set())
        self.detail_store.clear()
        try:
            for p, s in items:
                try:
                    ts = time.strftime('%Y-%m-%d %H:%M',
                                       time.localtime(os.lstat(p).st_mtime))
                except OSError:
                    ts = '—'
                if p.startswith('journalctl --'):
                    ts = '—'
                self.detail_store.append([s, hsize(s), ts, p, p in picked])
            self.detail_title = title
            self.detail_total = len(items)
            self.detail_size = sum(s for _, s in items)
            self.detail_err = r.get('err') or ''
            self._refresh_detail_head()
        except Exception as e:
            self.detail_head.set_markup(
                '<b>%s</b> · <span foreground="#c62828">读取明细失败:%s</span>'
                % (GLib.markup_escape_text(title), GLib.markup_escape_text(str(e))))

    # ---- 明细过滤:只影响列表显示,不改动左侧勾选,也不改数据

    def _detail_matches(self, model, it):
        q = self.detail_query
        if not q:
            return True
        path = model.get_value(it, 3) or ''
        size = model.get_value(it, 1) or ''
        ts = model.get_value(it, 2) or ''
        return (q in path.lower() or q in size.lower() or q in ts)

    def _detail_visible(self, model, it, data=None):
        return self._detail_matches(model, it)

    def _visible_count(self):
        n = 0
        it = self.detail_store.get_iter_first()
        while it is not None:
            if self._detail_matches(self.detail_store, it):
                n += 1
            it = self.detail_store.iter_next(it)
        return n

    def _refresh_detail_head(self):
        if not self.detail_title:
            return
        parts = ['<b>%s</b>' % GLib.markup_escape_text(self.detail_title),
                 hsize(self.detail_size)]
        if self.detail_total == 0:
            parts.append('<span color="#888888">没有匹配项</span>')
        elif self.detail_err:
            parts.append('<span foreground="#b26a00">%s</span>'
                         % GLib.markup_escape_text(self.detail_err))
        self.detail_head.set_markup(' · '.join(parts))

        if self.detail_query:
            n = self._visible_count()
            txt = '%d / %d 项匹配' % (n, self.detail_total)
            color = '#c62828' if n == 0 else '#888888'
        else:
            txt = '%d 项' % self.detail_total
            color = '#888888'
        self.match_label.set_markup('<span size="small" color="%s">%s</span>'
                                    % (color, GLib.markup_escape_text(txt)))

    def _on_detail_filter(self, entry):
        q = entry.get_text().strip().lower()
        if q == self.detail_query:
            return
        self.detail_query = q
        self.detail_filter.refilter()
        self._refresh_detail_head()

    def _on_search_key(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            widget.set_text('')
            return True
        return False

    # ---- 明细勾选:左侧整类 / 右侧逐条,两边实时联动

    def _on_detail_toggle(self, renderer, path):
        if not self.detail_key:
            return
        it = self.detail_model.get_iter(path)
        if it is None:
            return
        p = self.detail_model.get_value(it, D_PATH)
        s = self.sel.setdefault(self.detail_key, set())
        if p in s:
            s.discard(p)
        else:
            s.add(p)
        self._sync_cat(self.detail_key)
        self._sync_detail_checks(self.detail_key)
        self.update_summary()

    def _sync_detail_checks(self, key=None):
        """把已勾选集合刷到右侧勾选列(只处理当前显示的类别)。"""
        if not self.detail_key:
            return
        if key is not None and key != self.detail_key:
            return
        s = self.sel.get(self.detail_key, set())
        it = self.detail_store.get_iter_first()
        while it is not None:
            p = self.detail_store.get_value(it, D_PATH)
            want = p in s
            if bool(self.detail_store.get_value(it, D_CHK)) != want:
                self.detail_store.set_value(it, D_CHK, want)
            it = self.detail_store.iter_next(it)

    def _on_check_visible(self, btn, want):
        """对当前过滤结果批量勾选 / 取消勾选。"""
        if not self.detail_key:
            return
        s = self.sel.setdefault(self.detail_key, set())
        n = 0
        it = self.detail_store.get_iter_first()
        while it is not None:
            if self._detail_matches(self.detail_store, it):
                p = self.detail_store.get_value(it, D_PATH)
                if want:
                    s.add(p)
                else:
                    s.discard(p)
                n += 1
            it = self.detail_store.iter_next(it)
        self._sync_cat(self.detail_key)
        self._sync_detail_checks(self.detail_key)
        self.update_summary()
        self.status.set_text('%s %d 个文件'
                             % ('勾选' if want else '取消', n))

    def _on_win_key(self, widget, event):
        """Ctrl+F 聚焦明细过滤框。"""
        if (event.state & Gdk.ModifierType.CONTROL_MASK and
                event.keyval in (Gdk.KEY_f, Gdk.KEY_F)):
            self.detail_search.grab_focus()
            return True
        return False

    def _on_detail_tooltip(self, widget, x, y, keyboard, tooltip):
        pos = widget.get_path_at_pos(x, y)
        if not pos:
            return False
        # TreeView 挂在过滤层上,path 属于 filter,取值也要走 filter
        it = self.detail_model.get_iter(pos[0])
        if it is None:
            return False
        size = self.detail_model.get_value(it, 0)
        ts = self.detail_model.get_value(it, 2)
        path = self.detail_model.get_value(it, 3)
        hint = ''
        if not path.startswith('journalctl --'):
            hint = '\n<span size="small" color="#888888">双击可在文件管理器中定位</span>'
        tooltip.set_markup('<b>%s</b>  %s\n%s%s'
                           % (hsize(size), GLib.markup_escape_text(ts),
                              GLib.markup_escape_text(path), hint))
        return True

    # ---- 明细操作:双击定位 / 右键菜单

    def _on_detail_activate(self, tv, path, col):
        it = self.detail_model.get_iter(path)
        if it is None:
            return
        self.reveal(self.detail_model.get_value(it, 3))

    def _on_detail_click(self, widget, event):
        if event.button != 3:
            return False
        pos = widget.get_path_at_pos(int(event.x), int(event.y))
        if not pos:
            return False
        it = self.detail_model.get_iter(pos[0])
        if it is None:
            return False
        target = self.detail_model.get_value(it, 3)
        widget.get_selection().select_iter(it)
        menu = Gtk.Menu()
        if not target.startswith('journalctl --'):
            mi = Gtk.MenuItem(label='在文件管理器中显示')
            mi.connect('activate', lambda *a: self.reveal(target))
            menu.append(mi)
        mi = Gtk.MenuItem(label='复制路径')
        mi.connect('activate', lambda *a: self._copy(target))
        menu.append(mi)
        menu.show_all()
        menu.popup_at_pointer(event)
        return True

    def _copy(self, text):
        clip = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clip.set_text(text, -1)
        clip.store()
        self.status.set_text('已复制路径')

    def reveal(self, path):
        """在文件管理器中打开所在目录并选中该项"""
        if path.startswith('journalctl --'):
            self._info('这一项是 systemd 日志,没有对应文件。\n'
                       '清理时会按保留天数裁剪整个 journal 目录。')
            return
        if not os.path.exists(path):
            self._info('路径已不存在(可能已被清理):\n%s' % path)
            return
        uri = Gio.File.new_for_path(path).get_uri()
        # 1) 标准 D-Bus 接口:打开目录并选中
        try:
            rc = subprocess.call(
                ['dbus-send', '--session',
                 '--dest=org.freedesktop.FileManager1',
                 '--type=method_call',
                 '/org/freedesktop/FileManager1',
                 'org.freedesktop.FileManager1.ShowItems',
                 'array:string:' + uri, 'string:'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                timeout=10)
            if rc == 0:
                return
        except (OSError, subprocess.SubprocessError):
            pass
        # 2) dde-file-manager 自带的 --show-item
        try:
            subprocess.Popen(['dde-file-manager', '--show-item', uri],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
        except OSError:
            pass
        # 3) 兜底:只打开所在目录
        target = path if os.path.isdir(path) else os.path.dirname(path)
        try:
            subprocess.Popen(['dde-file-manager', '--new-window', target],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            self._info('打不开文件管理器。路径:\n%s' % path)

    def _on_tooltip(self, widget, x, y, keyboard, tooltip):
        res = widget.get_path_at_pos(x, y)
        if not res:
            return False
        path = res[0]
        it = self.cat_store.get_iter(path)
        key = self.cat_store.get_value(it, C_KEY)
        for c in CORE.CATALOG:
            if c[0] == key:
                extra = ''
                r = self.results.get(key)
                if r and r.get('err'):
                    extra = '\n<span foreground="#b26a00">%s</span>' \
                            % GLib.markup_escape_text(r['err'])
                tooltip.set_markup('<b>%s</b>\n%s%s'
                                   % (GLib.markup_escape_text(c[1]),
                                      GLib.markup_escape_text(c[3]), extra))
                return True
        return False

    # ------------------------------------------------------------ 清理

    def _need_root(self, key):
        for c in CORE.CATALOG:
            if c[0] == key:
                return c[5]
        return False

    def _cat_title(self, key):
        for c in CORE.CATALOG:
            if c[0] == key:
                return c[1]
        return key

    def _on_clean(self, btn):
        if self.cleaning or self.scanning:
            return
        plan = self.selected_plan()
        if not plan:
            self._info('没有勾选任何文件。')
            return
        nfiles = sum(len(v) for v in plan.values())
        total = sum(s for v in plan.values() for _, s in v)
        rows = []
        for k, items in plan.items():
            root = '(需密码) ' if self._need_root(k) else ''
            rows.append('%9s  %s%s  (%d 个文件)'
                        % (hsize(sum(s for _, s in items)), root,
                           self._cat_title(k), len(items)))
        dlg = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text='确认清理 %d 个文件,共 %s?' % (nfiles, hsize(total)))
        dlg.format_secondary_text('%s\n\n只删除上面列出的这些文件,删除后不可恢复。'
                                  % '\n'.join(rows))
        dlg.set_default_response(Gtk.ResponseType.CANCEL)
        resp = dlg.run()
        dlg.destroy()
        if resp != Gtk.ResponseType.OK:
            return
        self._execute(plan)

    def _execute(self, plan):
        self.cleaning = True
        self.clean_btn.set_sensitive(False)
        self.spinner.start()

        # sudo 缓存是滚动的,每次清理重新探测一次
        self.sudo_cached = self._sudo_cached()

        sys_plan = dict((k, v) for k, v in plan.items() if self._need_root(k))
        plain = [(p, s) for k, v in plan.items()
                 if not self._need_root(k) for p, s in v]
        privileged = [(p, s) for v in sys_plan.values() for p, s in v]

        if privileged:
            if self.sudo_cached:
                pass                                # 与普通文件一起 sudo -n 删
            elif self.can_pkexec:
                self._pkexec_delete(sys_plan)       # 系统图形认证框,不开终端
                privileged = []
            else:
                self._spawn_terminal(sys_plan)      # 兜底:终端里输密码
                privileged = []

        if not plain and not privileged:
            self.cleaning = False
            self.spinner.stop()
            self.update_summary()
            if sys_plan and not self.sudo_cached:
                self._info('系统文件需要管理员授权,在系统弹窗里确认后会自动删除。')
            return

        self.status.set_text('清理中…(%d 个文件)' % (len(plain) + len(privileged)))
        threading.Thread(target=self._clean_worker, args=(plain, privileged),
                         daemon=True).start()

    def _clean_worker(self, plain, privileged):
        freed = ok = 0
        failed = []
        if plain:
            f, o, e = CORE.delete_targets(plain, use_sudo=False)
            freed += f
            ok += o
            failed.extend(e)
        if privileged:
            CORE.SUDO = ['sudo', '-n']
            f, o, e = CORE.delete_targets(privileged, use_sudo=True)
            freed += f
            ok += o
            failed.extend(e)
        GLib.idle_add(self._clean_done, freed, ok, failed)

    def _clean_done(self, freed, ok, failed):
        self.cleaning = False
        self.spinner.stop()
        self.status.set_text('已清理 %d 项,回收 %s' % (ok, hsize(freed)))
        msg = '删除 %d 项,回收 %s' % (ok, hsize(freed))
        if failed:
            msg += '\n\n%d 项失败(可能在运行中或权限不足):\n' % len(failed)
            msg += '\n'.join(failed[:6])
            if len(failed) > 6:
                msg += '\n…'
        self._info(msg)
        self.rescan()
        return False

    # ---- 系统文件:走 pkexec 图形认证,不开终端

    def _pkexec_delete(self, plan):
        payload = [[p, s] for v in plan.values() for p, s in v]
        try:
            fd, path = tempfile.mkstemp(prefix='diskc-', suffix='.json')
            with os.fdopen(fd, 'w') as f:
                json.dump(payload, f)
            os.chmod(path, 0o600)
        except Exception as e:
            self.cleaning = False
            self.spinner.stop()
            self._info('生成清理清单失败:%s' % e, Gtk.MessageType.ERROR)
            return
        cmd = ['pkexec', PKEXEC_PY, DISKC, '--files-from', path]
        threading.Thread(target=self._pkexec_worker, args=(cmd, path),
                         daemon=True).start()

    def _pkexec_worker(self, cmd, path):
        rc, out = -1, ''
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT)
            out = p.communicate()[0].decode('utf-8', 'replace')
            rc = p.returncode
        except OSError as e:
            out = str(e)
        try:
            os.unlink(path)
        except OSError:
            pass
        GLib.idle_add(self._pkexec_done, rc, out)

    def _pkexec_done(self, rc, out):
        self.cleaning = False
        self.spinner.stop()
        if rc == 0:
            self.status.set_text('系统文件已清理')
            self._info('系统文件已删除。\n\n%s' % out.strip()[-300:])
        elif rc in (126, 127):
            self.update_summary()
            self._info('没有授权,系统文件保持原样。\n\n'
                       '这次只清理了普通文件。')
        else:
            self.update_summary()
            self._info('系统文件清理未完成(退出码 %d):\n\n%s'
                       % (rc, (out.strip() or '无输出')[-300:]),
                       Gtk.MessageType.WARNING)
        self.rescan()
        return False

    def _spawn_terminal(self, plan):
        """兜底:没有 pkexec 时把清单交给终端里的 sudo 精确删除。"""
        payload = [[p, s] for v in plan.values() for p, s in v]
        try:
            fd, path = tempfile.mkstemp(prefix='diskc-', suffix='.json')
            with os.fdopen(fd, 'w') as f:
                json.dump(payload, f)
            os.chmod(path, 0o600)
        except Exception as e:
            self._info('生成清理清单失败:%s' % e, Gtk.MessageType.ERROR)
            return
        inner = ('sudo python3 %s --files-from %s; rm -f %s; echo; '
                 'printf "按回车关闭窗口..."; read _'
                 % (_q(DISKC), _q(path), _q(path)))
        try:
            subprocess.Popen(['deepin-terminal', '--', 'bash', '-lc', inner])
        except OSError:
            self._info('未找到终端程序。请在终端手动执行:\n\n'
                       'sudo python3 %s --files-from %s' % (DISKC, path))

    def _info(self, text, mtype=Gtk.MessageType.INFO):
        dlg = Gtk.MessageDialog(transient_for=self, flags=0,
                                message_type=mtype,
                                buttons=Gtk.ButtonsType.OK)
        dlg.set_markup('<b>提示</b>')
        dlg.format_secondary_text(text)
        dlg.run()
        dlg.destroy()


def _q(s):
    return "'" + s.replace("'", "'\\''") + "'"


def main():
    app = Cleaner()
    app.show_all()

    if '--select' in sys.argv:
        i = sys.argv.index('--select')
        try:
            n = int(sys.argv[i + 1])
            GLib.timeout_add(1500, lambda: (app.select_row(n), False)[1])
        except (IndexError, ValueError):
            pass

    if '--filter' in sys.argv:
        i = sys.argv.index('--filter')
        try:
            txt = sys.argv[i + 1]
            GLib.timeout_add(2500, lambda: (app.detail_search.set_text(txt), False)[1])
        except IndexError:
            pass

    Gtk.main()


if __name__ == '__main__':
    main()

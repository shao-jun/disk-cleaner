        hb.pack_end(btn_rescan)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(box)

        # ---- 顶部:磁盘用量 + 阈值
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        top.set_border_width(10)
        box.pack_start(top, False, False, 0)

        self.disk_label = Gtk.Label()
        self.disk_label.set_xalign(0)
        top.pack_start(self.disk_label, False, False, 0)

        self.disk_bar = Gtk.ProgressBar()
        self.disk_bar.set_size_request(200, -1)

        top.pack_start(Gtk.Label(label='  时间阈值:'), False, False, 0)
        self.combo = Gtk.ComboBoxText()
        for label, d in (('30 天内不动过的', 30), ('60 天', 60),
                         ('90 天', 90), ('180 天', 180), ('不限时间', 0)):

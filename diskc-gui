        self.detail_head.set_ellipsize(Pango.EllipsizeMode.END)
        self.detail_head.set_markup('<span size="small" color="#888888">'
                                    '点击左侧类别查看文件 · 双击某一项可在文件管理器中定位</span>')
        head.pack_start(self.detail_head, True, True, 0)

        self.detail_search = Gtk.SearchEntry()
        self.detail_search.set_placeholder_text('过滤路径 / 大小 / 日期')
        self.detail_search.set_size_request(190, -1)
        # 用 changed 而不是 search-changed:后者有 150ms 延迟且异步,不是真实时
        self.detail_search.connect('changed', self._on_detail_filter)
        self.detail_search.connect('key-press-event', self._on_search_key)
        head.pack_end(self.detail_search, False, False, 0)

        # 匹配计数单独放,避免被类别名的省略号吃掉
        self.match_label = Gtk.Label()
        self.match_label.set_xalign(1.0)
        self.match_label.set_markup('<span size="small" color="#888888"></span>')
        head.pack_end(self.match_label, False, False, 0)

        # 第一列必须是 64 位:单个项目可超过 2G(< 2^31),用 int 会溢出导致明细整片空白
        self.detail_store = Gtk.ListStore(GObject.TYPE_INT64, str, str, str)

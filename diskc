    cutoff = time.time() - days * 86400 if days else 0
    items = []
    for fd in wx_file_dirs():
        for sub in sorted(os.listdir(fd)):
            subp = os.path.join(fd, sub)
            if not os.path.isdir(subp) or sub == 'Temp':
                continue
            try:
                entries = os.listdir(subp)
            except OSError:
                continue
            for name in entries:
                p = os.path.join(subp, name)
                if not os.path.isdir(p):
                    continue
                low = name.lower()
                named = any(k in low for k in ('var-log', 'varlog', 'logs',
                                               'log-', '-log', 'all_log',
                                               'syslog', 'dmesg'))

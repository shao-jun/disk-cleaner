def looks_like_log_dir(path):
    """目录是不是解压出来的日志包(含 var/log、varlog、log 等结构)"""
    for sub in ('var/log', 'varlog', 'logs', 'log'):
        if os.path.isdir(os.path.join(path, sub)):
            return True
    n = 0
    try:
        for base, dirs, files in os.walk(path, onerror=lambda e: None):
            for f in files:
                if f.lower().endswith('.log'):
                    n += 1
                    if n >= 5:
                        return True
            if base.count(os.sep) - path.count(os.sep) > 2:
                dirs[:] = []
    except OSError:
        pass
    return False



# ---------------------------------------------------------------- 小工具

def hsize(n):
    n = float(n)
    for u in ('B', 'K', 'M', 'G', 'T'):
        if n < 1024 or u == 'T':
            if u == 'B':
                return '%dB' % int(n)
            return '%.1f%s' % (n, u)
        n /= 1024.0


def dw(s):
    """显示宽度(中文算 2)"""
    w = 0
    for ch in s:
        w += 2 if unicodedata.east_asian_width(ch) in ('W', 'F') else 1
    return w


def pad(s, width, right=False):
    d = width - dw(s)
    if d <= 0:
        return s
    return (' ' * d + s) if right else (s + ' ' * d)


def is_root():
    return SUDO is not None


def run(cmd, use_sudo=False, timeout=180):
    """跑命令,返回 (rc, stdout)"""
    argv = list(cmd)
    if use_sudo:
        if SUDO is None:
            return 1, ''
        argv = list(SUDO) + argv
    try:
        p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = p.communicate(timeout=timeout)
        return p.returncode, out.decode('utf-8', 'replace')
    except Exception:
        return 1, ''


def path_size(p):
    """单个文件/目录的真实占用(不跟随软链)"""
    if os.path.islink(p):
        return 0
    if os.path.isfile(p):
        try:
            return os.path.getsize(p)
        except OSError:
            return 0
    total = 0
    stack = [p]
    while stack:
        d = stack.pop()
        try:
            with os.scandir(d) as it:
                for e in it:
                    try:
                        if e.is_symlink():
                            continue
                        if e.is_dir(follow_symlinks=False):
                            stack.append(e.path)
                        else:
                            total += e.stat(follow_symlinks=False).st_size
                    except OSError:
                        continue
        except OSError:
            continue
    return total


def walk_old_files(root, days, exts=None, keywords=None, min_size=0):
    """产出 root 下 mtime 早于 days 天的文件 -> (path, size)"""
    cutoff = time.time() - days * 86400 if days else 0
    out = []
    if not os.path.isdir(root):
        return out
    for base, dirs, files in os.walk(root, onerror=lambda e: None):
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(base, d))]
        for f in files:
            low = f.lower()
            if exts and not low.endswith(tuple(exts)):
                continue
            if keywords and not any(k in low for k in keywords):
                continue
            p = os.path.join(base, f)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if not os.path.isfile(p) or os.path.islink(p):
                continue
            if cutoff and st.st_mtime > cutoff:
                continue
            if st.st_size < min_size:
                continue
            out.append((p, st.st_size))
    return out



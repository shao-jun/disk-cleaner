def s_wine_cache(days):
    """Wine 容器里的临时文件 / 缓存"""
    items = []
    base = os.path.join(HOME, '.deepinwine')
    if not os.path.isdir(base):
        return items
    cands = []
    for cont in sorted(os.listdir(base)):
        c = os.path.join(base, cont)
        if not os.path.isdir(c):
            continue
        drive = os.path.join(c, 'drive_c')
        if not os.path.isdir(drive):
            continue
        cands.append(os.path.join(drive, 'windows', 'temp'))
        users = os.path.join(drive, 'users')
        if os.path.isdir(users):
            for u in os.listdir(users):
                ud = os.path.join(users, u)
                if not os.path.isdir(ud):
                    continue
                cands.append(os.path.join(ud, 'AppData', 'Local', 'Temp'))
                cands.append(os.path.join(ud, 'Local Settings', 'Temp'))
                for appdata in (os.path.join(ud, 'AppData', 'Local'),
                                os.path.join(ud, 'Local Settings')):
                    if not os.path.isdir(appdata):
                        continue
                    try:
                        for d in os.listdir(appdata):
                            if d.lower() in ('cache', 'temp', 'tmp',
                                             'temporary internet files'):
                                cands.append(os.path.join(appdata, d))
                    except OSError:
                        pass
    seen = set()
    for p in cands:
        if p in seen or not os.path.isdir(p):
            continue
        seen.add(p)
        sz = path_size(p)
        if sz > 10 * 1024 ** 2:
            items.append((p, sz))
    return items



def scan_all(days, only=None, verbose=True):
    results = {}
    cats = [c for c in CATALOG if not only or c[0] in only]
    if verbose:
        sys.stdout.write('扫描中...\n')
        sys.stdout.flush()

    def work(c):
        key, title, risk, desc, fn, need_root, picked, day_aware = c
        try:
            items = fn(days)
        except Exception as e:
            return key, [], '扫描失败: %s' % e
        if need_root and SUDO is None:
            # 无 root 也能读到大小(stat 不需要文件读权限),只是清理时需要提权
            return key, items, '需管理员权限,仅预览'
        return key, items, None

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        futs = [ex.submit(work, c) for c in cats]
        for f in concurrent.futures.as_completed(futs):
            k, items, err = f.result()
            results[k] = {'items': items, 'err': err}
    return results


def cat_by_key(key):
    for c in CATALOG:
        if c[0] == key:
            return c
    return None


def render(results, selected, days):
    print()
    hdr = ' %s %s %s %s %s' % (pad('#', 3), pad('类别', 22), pad('风险', 6),
                               pad('可释放', 9, True), ' 说明')
    print('\033[1m' + hdr + '\033[0m')
    print(' ' + '-' * 96)
    idx_map = {}
    total_sel = 0
    i = 0
    for c in CATALOG:
        key, title, risk, desc, fn, need_root, picked, day_aware = c
        if key not in results:
            continue
        i += 1
        idx_map[i] = key
        r = results[key]
        items = r['items']
        size = sum(s for _, s in items)
        if key in selected:
            total_sel += size
        mark = '\033[7m x \033[0m' if key in selected else '   '
        color = RISK_COLOR[risk]
        line = ' %s %s %s%s\033[0m %s  %s' % (
            mark, pad(title, 22), color, pad(RISK_LABEL[risk], 6),
            pad(hsize(size), 9, True), desc)
        if r['err']:
            line += '  \033[31m(%s)\033[0m' % r['err']
        elif items:
            line += '  \033[90m%d 项\033[0m' % len(items)
        print(line)
    print(' ' + '-' * 96)
    print(' 已选 \033[1m%s\033[0m  |  阈值 %d 天  |  %s' %
          (hsize(total_sel), days,
           '管理员权限: 有' if SUDO is not None else '管理员权限: 无(系统类目跳过)'))
    return idx_map


def details(key, results, limit=40):
    r = results.get(key)
    if not r:
        return
    c = cat_by_key(key)
    print('\n\033[1m%s\033[0m — %s' % (c[1], c[3]))
    items = sorted(r['items'], key=lambda x: -x[1])
    print('共 %d 项,合计 %s\n' % (len(items), hsize(sum(s for _, s in items))))
    for p, s in items[:limit]:
        print('  %9s  %s' % (hsize(s), p))
    if len(items) > limit:
        print('  ... 还有 %d 项' % (len(items) - limit))
    print()


# ---------------------------------------------------------------- 执行清理

def delete_targets(items, use_sudo):
    """返回 (释放字节, 删除项数, 失败列表)"""
    freed = 0
    ok = 0
    failed = []
    plain = use_sudo is False
    batch = []
    for path, size in items:
        if path.startswith('journalctl --'):
            continue
        batch.append((path, size))
        if len(batch) >= 200:
            f, o, e = _flush(batch, use_sudo)
            freed += f
            ok += o
            failed.extend(e)
            batch = []
    if batch:
        f, o, e = _flush(batch, use_sudo)
        freed += f
        ok += o
        failed.extend(e)
    return freed, ok, failed


def _flush(batch, use_sudo):
    freed = 0
    ok = 0
    failed = []
    if use_sudo:
        paths = [p for p, _ in batch]
        argv = list(SUDO) + ['rm', '-rf', '--'] + paths
        try:
            rc = subprocess.call(argv, stdout=DEVNULL, stderr=DEVNULL)
        except Exception:
            rc = 1
        for p, s in batch:
            if not os.path.exists(p):
                freed += s
                ok += 1
            else:
                failed.append(p)
        return freed, ok, failed
    for p, s in batch:
        try:
            if os.path.islink(p) or os.path.isfile(p):
                os.remove(p)
            elif os.path.isdir(p):
                shutil.rmtree(p, onerror=lambda f, pa, exc: None)
            else:
                continue
            freed += s
            ok += 1
        except OSError as e:
            failed.append('%s (%s)' % (p, e.strerror))
    return freed, ok, failed


def wx_running():
    rc, out = run(['pgrep', '-f', 'WXWork|wxwork|WXWorkWeb'])
    return out.strip() != ''


def do_clean(keys, results, days, assume_yes=False):
    plan = []
    for key in keys:
        r = results.get(key)
        if not r:
            continue
        plan.extend([(p, s, key) for p, s in r['items']])
    if not plan:
        print('\n没有可清理的内容。')
        return 0

    total = sum(s for _, s, _ in plan)
    print('\n\033[1m即将清理\033[0m: %d 项,合计 \033[1m%s\033[0m' % (len(plan), hsize(total)))
    if any(k.startswith('wx') for k in keys) and wx_running():
        print('\033[33m提示: 企业微信正在运行,建议退出后再清理它的缓存,'
              '否则可能遇到文件占用。\033[0m')
    for key in keys:
        c = cat_by_key(key)
        sz = sum(s for p, s, k in plan if k == key)
        print('  · %-24s %s' % (c[1], hsize(sz)))
    if not assume_yes:
        try:
            ans = input('\n确认删除?输入 yes 继续: ').strip().lower()
        except EOFError:
            return 1
        if ans != 'yes':
            print('已取消,什么都没删。')
            return 1

    # journal 用 vacuum
    if 'journal' in keys:
        keep = min(days, 7) if days else 7
        print('\n  -> journalctl --vacuum-time=%dd ...' % keep)
        rc, out = run(['journalctl', '--vacuum-time=%dd' % keep], use_sudo=True)
        m = re.search(r'freed ([\d.]+)([KMG])', out)
        if m:
            mult = {'K': 1024, 'M': 1024 ** 2, 'G': 1024 ** 3}[m.group(2)]
            print('     释放 %s' % hsize(float(m.group(1)) * mult))

    items = [(p, s) for p, s, k in plan if not p.startswith('journalctl --')]
    sys_log = any(cat_by_key(k)[5] for k in keys)
    use_sudo = SUDO is not None and sys_log
    freed = 0
    if items:
        freed, ok, failed = delete_targets(items, use_sudo)
        print('\n  -> 已删除 %d 项,回收 \033[32m%s\033[0m' % (ok, hsize(freed)))
        if failed:
            print('     %d 项删除失败(权限或占用),例如:' % len(failed))
            for f in failed[:5]:
                print('       %s' % f)

    remaining = _disk_free()
    print('\n磁盘可用空间: \033[1m%s\033[0m' % remaining)
    if not sys_log and SUDO is None:
        print('提示: 系统日志类目因缺少管理员权限未清理,用 sudo diskc 可以一并处理。')
    return 0


def _disk_free():
    try:
        st = os.statvfs(HOME)
        return hsize(st.f_bavail * st.f_frsize)
    except OSError:
        return '?'


# ---------------------------------------------------------------- 主流程

def parse_sel(s, idx_map):
    out = []
    for part in s.replace(' ', ',').split(','):
        if not part:
            continue
        if '-' in part:
            try:
                a, b = part.split('-', 1)
                a, b = int(a), int(b)
                for n in range(a, b + 1):
                    if n in idx_map:
                        out.append(idx_map[n])
            except ValueError:
                pass
        else:
            try:
                n = int(part)
                if n in idx_map:
                    out.append(idx_map[n])
            except ValueError:
                pass
    return out


def init_sudo():
    global SUDO
    if os.geteuid() == 0:
        SUDO = []
        return
    rc, _ = run(['sudo', '-n', 'true'])
    if rc == 0:
        SUDO = ['sudo', '-n']
        return
    if sys.stdin.isatty():
        print('清理系统日志需要管理员权限。输入密码(直接回车跳过系统类目):')
        try:
            if subprocess.call(['sudo', '-v']) == 0:
                SUDO = ['sudo', '-n']
                return
        except Exception:
            pass
    SUDO = None


def main():
    global DAYS
    ap = argparse.ArgumentParser(add_help=True, description='UOS 磁盘垃圾清理工具')
    ap.add_argument('-n', '--dry-run', action='store_true', help='只扫描列清单')
    ap.add_argument('-y', '--yes', action='store_true', help='不询问直接执行')
    ap.add_argument('-s', '--safe', action='store_true', help='只处理安全级项目')
    ap.add_argument('-a', '--all-risk', action='store_true', help='安全+谨慎级全选')
    ap.add_argument('-i', '--items', default='', help='指定编号,如 1,3,11-13')
    ap.add_argument('--keys', default='', help='按类别 key 指定,如 journal,apt,rotated')
    ap.add_argument('-d', '--days', type=int, default=30, help='时间阈值(天),默认 30')
    ap.add_argument('-l', '--list', action='store_true', help='只列类别说明')
    ap.add_argument('--files-from', default='',
                    help='按清单精确删除:JSON 文件,内容为 [[路径,字节],...](GUI 用)')
    args = ap.parse_args()

    DAYS = args.days

    if args.list:
        for i, c in enumerate(CATALOG, 1):
            print('%2d  %s%-8s\033[0m %-24s %s'
                  % (i, RISK_COLOR[c[2]], RISK_LABEL[c[2]], c[1], c[3]))
        return 0

    # GUI 转过来的精确清单:只删这些路径,不做全盘扫描
    if args.files_from:
        init_sudo()
        try:
            with open(args.files_from) as f:
                data = json.load(f)
        except Exception as e:
            print('读取清单失败:%s' % e)
            return 2
        items = [(str(p), int(s)) for p, s in data]
        if not items:
            print('清单为空,没有要删除的文件。')
            return 0
        print('按清单清理 %d 项,共 %s'
              % (len(items), hsize(sum(s for _, s in items))))
        freed, ok, failed = delete_targets(items, use_sudo=is_root())
        print('删除 %d 项,回收 %s' % (ok, hsize(freed)))
        if failed:
            print('%d 项失败:' % len(failed))
            for p in failed[:20]:
                print('  %s' % p)
            return 1
        return 0

    init_sudo()
    results = scan_all(DAYS)

    if args.keys:
        selected = set(k.strip() for k in args.keys.split(',') if k.strip() in results)
    elif args.items:
        tmp = {}
        i = 0
        for c in CATALOG:
            if c[0] in results:
                i += 1
                tmp[i] = c[0]
        selected = set(parse_sel(args.items, tmp))
    elif args.safe:
        selected = set(c[0] for c in CATALOG if c[6] and c[0] in results)
    elif args.all_risk:
        selected = set(c[0] for c in CATALOG if c[2] in ('safe', 'careful')
                       and c[0] in results)
    else:
        selected = set(c[0] for c in CATALOG if c[6] and c[0] in results)

    if args.dry_run or args.yes:
        render(results, selected, DAYS)
        if args.dry_run:
            print('\n(dry-run:未删除任何文件。去掉 -n 即可交互清理)')
            return 0
        return do_clean(selected, results, DAYS, assume_yes=True)

    # 交互
    while True:
        idx_map = render(results, selected, DAYS)
        print('\n命令: [编号]切换  a=全选安全  b=安全+谨慎  n=清空  d<N>=详情  '
              'r=重扫  q=退出  \033[1m回车=开始清理\033[0m')
        try:
            cmd = input('> ').strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if cmd == '':
            if not selected:
                print('没有选中任何项目。')
                continue
            return do_clean(selected, results, DAYS)
        if cmd == 'q':
            print('退出,未做任何修改。')
            return 0
        if cmd == 'a':
            selected = set(c[0] for c in CATALOG if c[6] and c[0] in results)
            continue
        if cmd == 'b':
            selected = set(c[0] for c in CATALOG if c[2] in ('safe', 'careful')
                           and c[0] in results)
            continue
        if cmd == 'n':
            selected = set()
            continue
        if cmd == 'r':
            results = scan_all(DAYS)
            continue
        if cmd.startswith('d'):
            rest = cmd[1:].strip()
            if rest.isdigit() and int(rest) in idx_map:
                details(idx_map[int(rest)], results)
            else:
                print('用法: d3  (查看第 3 项明细)')
            continue
        keys = parse_sel(cmd, idx_map)
        if not keys:
            print('无法识别的命令。')
            continue
        for k in keys:
            if k in selected:
                selected.discard(k)
            else:
                selected.add(k)


if __name__ == '__main__':
    try:
        sys.exit(main() or 0)
    except KeyboardInterrupt:
        print('\n已中断。')
        sys.exit(130)

def _real_home():
    """被 sudo / pkexec 提权运行时,仍以调用者的家目录为准"""
    h = os.environ.get('HOME') or os.path.expanduser('~')
    if os.geteuid() == 0:
        try:
            import pwd
            u = os.environ.get('SUDO_USER')
            if u and u != 'root':
                return pwd.getpwnam(u).pw_dir
            uid = os.environ.get('PKEXEC_UID')
            if uid:
                return pwd.getpwuid(int(uid)).pw_dir
        except (KeyError, ValueError, ImportError):
            pass
    return h



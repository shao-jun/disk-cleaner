def s_journal(days):
    """systemd journal 持久化日志"""
    items = []
    rc, out = run(['journalctl', '--disk-usage'], use_sudo=True)
    total = 0
    m = re.search(r'([\d.]+)([KMGTP]?)', out or '')
    if m and 'take up' in out:
        mult = {'': 1, 'K': 1024, 'M': 1024 ** 2, 'G': 1024 ** 3,
                'T': 1024 ** 4, 'P': 1024 ** 5}[m.group(2)]
        total = int(float(m.group(1)) * mult)
    keep = min(days, 7) if days else 7
    if total == 0:
        # 无 root 时 journalctl 读不到总量,退化为统计目录
        jd = '/var/log/journal'
        if os.path.isdir(jd):
            total = path_size(jd)
    if total > 32 * 1024 ** 2:
        items.append(('journalctl --vacuum-time=%dd' % keep, total))
    return items


def s_apt(days):
    items = []
    for pat in ('/var/cache/apt/archives/*.deb',
                '/var/cache/apt/archives/partial/*'):
        for p in glob.glob(pat):
            if os.path.isfile(p):
                items.append((p, path_size(p)))
    return items


def s_coredump(days):
    items = []
    for root, kw in (('/var/crash', None),
                     ('/var/lib/systemd/coredump', None),
                     ('/var/tmp/core*', None)):
        if root.endswith('*'):
            for p in glob.glob(root):
                items.append((p, path_size(p)))
            continue
        if not os.path.isdir(root):
            continue
        for name in os.listdir(root):
            if name in ('.', '..'):
                continue
            p = os.path.join(root, name)
            items.append((p, path_size(p)))
    return items


def s_vartmp(days):
    d = 7 if days == 0 else min(days, 7)
    items = []
    root = '/var/tmp'
    if not os.path.isdir(root):
        return items
    cutoff = time.time() - d * 86400
    for name in os.listdir(root):
        p = os.path.join(root, name)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        if st.st_mtime > cutoff:
            continue
        items.append((p, path_size(p)))
    return items


ROTATED_RE = re.compile(r'\.(gz|xz|bz2|zst|old|bak)$|\.\d+$', re.I)


def s_rotated_log(days):
    items = []
    root = '/var/log'
    if not os.path.isdir(root):
        return items
    for base, dirs, files in os.walk(root, onerror=lambda e: None):
        if os.path.join(root, 'journal') in base or base.endswith('/journal'):
            dirs[:] = []
            continue
        for f in files:
            if not ROTATED_RE.search(f):
                continue
            p = os.path.join(base, f)
            if os.path.islink(p):
                continue
            items.append((p, path_size(p)))
    return items


